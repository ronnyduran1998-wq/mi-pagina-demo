<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verificación de Certificado - INFOTEP</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        infotep: {
                            blue: '#00529B',
                            lightBlue: '#00A8E8',
                            yellow: '#FFC72C',
                            gray: '#F8FAFC',
                            cardBorder: '#E2E8F0'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @media print {
            .no-print {
                display: none !important;
            }
            body {
                background: white !important;
                padding: 0 !important;
            }
            .print-full-width {
                width: 100% !important;
                max-width: none !important;
                box-shadow: none !important;
                border: none !important;
            }
        }
    </style>
</head>
<body class="bg-gray-100 font-sans min-h-screen text-gray-800 flex flex-col justify-between antialiased">

    <div>
        <!-- Top Banner Header -->
        <header class="bg-white border-b border-gray-200 shadow-sm sticky top-0 z-50">
            <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold text-xl shadow-md">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-gray-900 text-lg leading-tight">Verificación de Certificado</h1>
                        <p class="text-xs text-gray-500">Sistema Oficial de Validaciones</p>
                    </div>
                </div>

                <!-- Action Controls -->
                <div class="flex items-center space-x-2 no-print">
                    <button onclick="toggleEditModal()" class="inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition">
                        <i class="fa-solid fa-pen-to-square mr-1.5 text-blue-600"></i> Editar mis Datos
                    </button>
                    <button onclick="window.print()" class="inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition shadow-sm">
                        <i class="fa-solid fa-print mr-1.5"></i> Imprimir
                    </button>
                </div>
            </div>
        </header>

        <!-- Main Container -->
        <main class="max-w-4xl mx-auto px-4 py-6 space-y-6">

            <!-- Verification Notice Box -->
            <div class="bg-white rounded-xl p-4 shadow-sm border-l-4 border-emerald-500 flex items-start space-x-3">
                <div class="text-emerald-500 text-xl mt-0.5">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div class="text-sm text-gray-700 leading-relaxed">
                    El certificado que está consultando fue emitido por el <strong class="text-gray-900 font-semibold">Instituto Nacional de Formación Técnico Profesional (INFOTEP)</strong> a la persona que se muestra a continuación.
                </div>
            </div>

            <!-- Participant Card -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden print-full-width">
                <!-- Card Header -->
                <div class="bg-white px-6 py-3 border-b border-gray-100 flex justify-between items-center border-t-4 border-t-blue-600">
                    <span class="text-sm font-semibold text-gray-600 uppercase tracking-wide">Participante</span>
                    <span class="text-xs px-2.5 py-1 bg-emerald-50 text-emerald-700 font-semibold rounded-full border border-emerald-200">
                        <i class="fa-solid fa-shield-halved text-xs mr-1"></i> Verificado
                    </span>
                </div>

                <!-- Card Content -->
                <div class="p-6 text-center">
                    <!-- Graduation Icon / Profile Avatar -->
                    <div class="relative inline-block mb-3">
                        <div class="w-24 h-24 mx-auto rounded-full bg-slate-800 text-white flex items-center justify-center shadow-inner overflow-hidden border-2 border-slate-200">
                            <i class="fa-solid fa-user-graduate text-5xl mt-2 text-slate-200" id="avatarIcon"></i>
                            <img id="avatarImg" class="hidden w-full h-full object-cover" alt="Foto de Perfil" />
                        </div>
                    </div>

                    <!-- Full Name -->
                    <h2 class="text-xl md:text-2xl font-bold text-gray-900 tracking-wide uppercase" id="displayName">
                        CINDY NICOLE ALONZO GOMEZ
                    </h2>

                    <!-- Horizontal Divider -->
                    <div class="w-full max-w-md mx-auto border-t border-gray-200 my-5"></div>

                    <!-- Details Grid (Document & Matricula) -->
                    <div class="grid grid-cols-2 gap-4 max-w-xs mx-auto">
                        <!-- Document Number -->
                        <div class="text-center">
                            <p class="text-base font-bold text-blue-600 tracking-wider" id="displayDocument">40212697441</p>
                            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mt-0.5">NO. DOCUMENTO</p>
                        </div>
                        <!-- Registration Number -->
                        <div class="text-center border-l border-gray-200 pl-4">
                            <p class="text-base font-bold text-gray-800 tracking-wider" id="displayMatricula">2790464</p>
                            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mt-0.5">MATRÍCULA</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Certificates List Card -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden print-full-width">
                <!-- Card Header -->
                <div class="bg-white px-6 py-3 border-b border-gray-100 flex flex-wrap justify-between items-center gap-2 border-t-4 border-t-amber-400">
                    <span class="text-sm font-semibold text-gray-600 uppercase tracking-wide">Certificado</span>
                    
                    <!-- Search Input for Filter -->
                    <div class="no-print relative">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-xs text-gray-400"></i>
                        <input type="text" id="searchInput" onkeyup="filterTable()" placeholder="Buscar capacitación..." 
                               class="pl-8 pr-3 py-1 text-xs border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    </div>
                </div>

                <!-- Certificate Table -->
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse" id="certTable">
                        <thead>
                            <tr class="bg-gray-100 text-gray-700 text-xs font-semibold uppercase tracking-wider border-b border-gray-200">
                                <th class="py-3 px-4">Capacitación</th>
                                <th class="py-3 px-3 text-center">Libro</th>
                                <th class="py-3 px-3 text-center">Folio</th>
                                <th class="py-3 px-3 text-center">No. Egresado</th>
                                <th class="py-3 px-4">Regional</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 text-sm" id="tableBody">
                            <!-- Rows will be injected dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 mt-10 py-6 text-center text-xs text-gray-500">
        <div class="max-w-4xl mx-auto px-4 space-y-1">
            <p>Copyright © 2026 <strong class="text-blue-600">Infotep Certificados</strong>. All rights reserved.</p>
        </div>
    </footer>

    <!-- EDIT MODAL -->
    <div id="editModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center hidden p-4 no-print">
        <div class="bg-white rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto shadow-2xl p-6 space-y-6">
            <div class="flex justify-between items-center border-b pb-3">
                <h3 class="text-lg font-bold text-gray-800">
                    <i class="fa-solid fa-user-gear text-blue-600 mr-2"></i> Personalizar Datos del Certificado
                </h3>
                <button onclick="toggleEditModal()" class="text-gray-400 hover:text-gray-600 text-xl font-bold">&times;</button>
            </div>

            <!-- Form -->
            <form id="editForm" onsubmit="saveData(event)" class="space-y-4">
                <!-- Personal Info Section -->
                <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-blue-600 mb-2">Información del Participante</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Nombre Completo</label>
                            <input type="text" id="inputName" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none" required>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">No. Documento</label>
                            <input type="text" id="inputDocument" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none" required>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Matrícula</label>
                            <input type="text" id="inputMatricula" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none" required>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">URL Foto Perfil (Opcional)</label>
                            <input type="url" id="inputPhoto" placeholder="https://ejemplo.com/foto.jpg" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none">
                        </div>
                    </div>
                </div>

                <hr class="border-gray-200">

                <!-- Course Info Section -->
                <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-amber-600 mb-2">Información de la Capacitación</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div class="md:col-span-2">
                            <label class="block text-xs font-medium text-gray-700 mb-1">Capacitación</label>
                            <input type="text" id="inputCapacitacion" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none" required>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Libro</label>
                            <input type="text" id="inputLibro" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none" required>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Folio</label>
                            <input type="text" id="inputFolio" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none" required>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">No. Egresado</label>
                            <input type="text" id="inputEgresado" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none" required>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Regional</label>
                            <input type="text" id="inputRegional" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none" required>
                        </div>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="flex justify-end space-x-3 pt-4 border-t">
                    <button type="button" onclick="toggleEditModal()" class="px-4 py-2 text-sm font-medium text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">Cancelar</button>
                    <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm">
                        <i class="fa-solid fa-floppy-disk mr-1"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Initial Data Structure
        let currentData = {
            name: "CINDY NICOLE ALONZO GOMEZ",
            document: "40212697441",
            matricula: "2790464",
            photoUrl: "",
            certificates: [
                {
                    capacitacion: "AUXILIAR DE FARMACIA",
                    libro: "457",
                    folio: "186",
                    egresado: "1",
                    regional: "UTESA CORAL MALL"
                }
            ]
        };

        // Render UI with Current State
        function renderUI() {
            // Render Text Elements
            document.getElementById('displayName').innerText = currentData.name;
            document.getElementById('displayDocument').innerText = currentData.document;
            document.getElementById('displayMatricula').innerText = currentData.matricula;

            // Render Avatar Photo or Fallback Icon
            const avatarImg = document.getElementById('avatarImg');
            const avatarIcon = document.getElementById('avatarIcon');

            if (currentData.photoUrl && currentData.photoUrl.trim() !== '') {
                avatarImg.src = currentData.photoUrl;
                avatarImg.classList.remove('hidden');
                avatarIcon.classList.add('hidden');
            } else {
                avatarImg.classList.add('hidden');
                avatarIcon.classList.remove('hidden');
            }

            // Render Certificate Table Rows
            const tableBody = document.getElementById('tableBody');
            tableBody.innerHTML = '';

            currentData.certificates.forEach((cert, index) => {
                const row = document.createElement('tr');
                row.className = index % 2 === 0 ? 'bg-white' : 'bg-slate-50/50';
                
                row.innerHTML = `
                    <td class="py-3 px-4 font-semibold text-gray-800">${cert.capacitacion}</td>
                    <td class="py-3 px-3 text-center text-gray-600 font-mono">${cert.libro}</td>
                    <td class="py-3 px-3 text-center text-gray-600 font-mono">${cert.folio}</td>
                    <td class="py-3 px-3 text-center text-gray-600 font-mono">${cert.egresado}</td>
                    <td class="py-3 px-4 text-gray-700">${cert.regional}</td>
                `;
                tableBody.appendChild(row);
            });
        }

        // Modal Toggle
        function toggleEditModal() {
            const modal = document.getElementById('editModal');
            modal.classList.toggle('hidden');

            if (!modal.classList.contains('hidden')) {
                // Populate Form with current state
                document.getElementById('inputName').value = currentData.name;
                document.getElementById('inputDocument').value = currentData.document;
                document.getElementById('inputMatricula').value = currentData.matricula;
                document.getElementById('inputPhoto').value = currentData.photoUrl || '';

                // Main certificate data
                const mainCert = currentData.certificates[0] || {};
                document.getElementById('inputCapacitacion').value = mainCert.capacitacion || '';
                document.getElementById('inputLibro').value = mainCert.libro || '';
                document.getElementById('inputFolio').value = mainCert.folio || '';
                document.getElementById('inputEgresado').value = mainCert.egresado || '';
                document.getElementById('inputRegional').value = mainCert.regional || '';
            }
        }

        // Save Form Data
        function saveData(e) {
            e.preventDefault();

            currentData.name = document.getElementById('inputName').value.trim().toUpperCase();
            currentData.document = document.getElementById('inputDocument').value.trim();
            currentData.matricula = document.getElementById('inputMatricula').value.trim();
            currentData.photoUrl = document.getElementById('inputPhoto').value.trim();

            // Update certificate
            currentData.certificates[0] = {
                capacitacion: document.getElementById('inputCapacitacion').value.trim().toUpperCase(),
                libro: document.getElementById('inputLibro').value.trim(),
                folio: document.getElementById('inputFolio').value.trim(),
                egresado: document.getElementById('inputEgresado').value.trim(),
                regional: document.getElementById('inputRegional').value.trim().toUpperCase()
            };

            renderUI();
            toggleEditModal();
        }

        // Filter Table Function
        function filterTable() {
            const filter = document.getElementById('searchInput').value.toLowerCase();
            const table = document.getElementById('certTable');
            const trs = table.getElementsByTagName('tr');

            for (let i = 1; i < trs.length; i++) {
                const td = trs[i].getElementsByTagName('td')[0];
                if (td) {
                    const txtValue = td.textContent || td.innerText;
                    if (txtValue.toLowerCase().indexOf(filter) > -1) {
                        trs[i].style.display = "";
                    } else {
                        trs[i].style.display = "none";
                    }
                }
            }
        }

        // Initialize App on Page Load
        window.onload = function() {
            renderUI();
        };
    </script>
</body>
</html>
